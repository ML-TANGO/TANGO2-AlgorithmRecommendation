# ===== Prompt generator (pretrained LLM) =====
# hf: transformers로 컨테이너 내부에서 직접 로드
# openai: vLLM/TGI 등 OpenAI 호환 서버 호출 (PM_*_BASE_URL 필요)
# mock: 테스트용 가짜 모델
PM_GENERATOR_BACKEND=hf
PM_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
# PM_GENERATOR_BASE_URL=http://vllm-generator:8000/v1
PM_GENERATOR_TEMPERATURE=0.8
PM_GENERATOR_MAX_NEW_TOKENS=1024

# ===== Prompt optimizer (학습된 optimizer 모델) =====
PM_OPTIMIZER_BACKEND=hf
# 풀 파인튜닝 모델이면 경로/이름을 MODEL에, LoRA면 베이스를 MODEL, 어댑터를 ADAPTER에 지정
PM_OPTIMIZER_MODEL=Qwen/Qwen2.5-7B-Instruct
# PM_OPTIMIZER_ADAPTER=/adapters/optimizer-lora
# template: optimizer_prompt.j2로 감싸서 입력 / raw: 초안 프롬프트만 그대로 입력 (학습 포맷에 맞춰 선택)
PM_OPTIMIZER_INPUT_MODE=template
PM_OPTIMIZER_TEMPERATURE=0.0

# ===== Candidate selection (self-confidence) =====
PM_ENABLE_CANDIDATE_SELECTION=true
PM_NUM_CANDIDATES=4
# logprob | verbalized | hybrid
PM_CONFIDENCE_METHOD=logprob

# ===== HF runtime =====
PM_TORCH_DTYPE=bfloat16
PM_LOAD_IN_4BIT=false
# HF_TOKEN=hf_xxx   # gated 모델 사용 시
