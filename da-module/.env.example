# 모델 변경: 이 항목을 HF 모델 ID 또는 컨테이너 안의 모델 경로로 바꾸세요.
DA_MODEL=google/gemma-4-E4B-it
DA_BACKEND=hf
DA_TORCH_DTYPE=bfloat16
DA_DEVICE_MAP=auto
DA_TRUST_REMOTE_CODE=false
DA_MAX_NEW_TOKENS=512

# DA: http://localhost:8002/docs, 데모 수신기: http://localhost:8003/docs
DA_PORT=8002
DA_RECEIVER_PORT=8003
DA_GPU_ID=0

# PO에서 이미 다운로드한 모델 캐시를 공유합니다. 독립 실행 시 ./models로 변경하세요.
DA_MODELS_DIR=../prompt-module/models

# 실제 후속 모듈이 준비되면 이 주소를 변경하세요.
# 컨테이너에서 호스트의 API를 호출할 때: http://host.docker.internal:포트/경로
DA_DOWNSTREAM_URL=http://demo-receiver:8000/v1/labels
DA_DOWNSTREAM_TIMEOUT=30
