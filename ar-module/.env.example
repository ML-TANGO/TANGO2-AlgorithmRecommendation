# ===== Workspace layout (all optional; defaults are relative to this module) =====
# Generated stage artifacts (Stage 1-4, revised 2/3/4, training outputs, inference results)
#AR_ARTIFACTS_DIR=/abs/path/to/artifacts
# Candidate catalogs (task/gpu/language/context/model/metric/hyper-parameter lists)
#AR_DATASET_DIR=/abs/path/to/resources/dataset
# Prepared SFT data (train/validation/test.jsonl + catalog.json + preparation_report.json)
#AR_DATA_DIR=/abs/path/to/data

# ===== Recommender model =====
# Trained checkpoint used by `infer` and `demo` (final/ or checkpoint-N/)
AR_CHECKPOINT=checkpoints/gemma4-lora-final
# Base model for training and for Stage 4 request generation
AR_BASE_MODEL=google/gemma-4-E4B-it
AR_BASE_REVISION=main
# Hugging Face cache / offline use
# Host hub cache mounted into the Docker demo container (docker compose volume).
# Set it explicitly when running "sudo docker compose": the default ~/.cache/huggingface/hub would resolve to /root.
#HF_CACHE=/home/<user>/.cache/huggingface/hub
#HF_HOME=/home/<user>/.cache/huggingface
#HF_HUB_OFFLINE=1
#HF_TOKEN=hf_xxx   # gated models

# ===== Demo =====
DEMO_PORT=8004
# Host GPU index exposed to the Docker demo container (docker compose device_ids)
AR_GPU_ID=3
